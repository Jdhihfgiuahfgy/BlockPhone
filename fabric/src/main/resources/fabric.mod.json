{
  "schemaVersion": 1,
  "id": "blockphone",
  "version": "${version}",
  "name": "BlockPhone",
  "description": "A smartphone in your HUD: camera, gallery, music, notes, a server messenger with voice messages and calls, and a feed.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/blockphone/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.blockphone.fabric.BlockPhoneFabric"
    ],
    "client": [
      "dev.blockphone.fabric.client.BlockPhoneClient"
    ],
    "voicechat": [
      "dev.blockphone.common.voice.SvcPlugin"
    ]
  },
  "mixins": [
    {
      "config": "blockphone.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "suggests": {
    "voicechat": "*"
  }
}
